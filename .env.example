
# ==========================================
# AutoIssueHunter - Environment Configuration
# ==========================================

# GitHub API
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Database
DATABASE_PATH=data/issuehunter.sqlite3

# Repository workspace
WORKSPACE_PATH=workspace/

# Application
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
OLLAMA_NUM_CTX=8192 # depending on model selection

# Discovery defaults
DEFAULT_LANGUAGE=python
DEFAULT_DEVELOPER_LEVEL=intermediate
MAX_ISSUES_PER_SCAN=50
